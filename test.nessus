<ReportItem port="445" svc_name="cifs" protocol="tcp" severity="0" pluginID="10456" pluginName="Microsoft Windows SMB Service Enumeration" pluginFamily="Windows">
<asset_inventory>True</asset_inventory>
<cpe>cpe:/o:microsoft:windows</cpe>
<description>This plugin implements the SvcOpenSCManager() and SvcEnumServices() calls to obtain, using the SMB protocol, the list of active and inactive services of the remote host.

An attacker may use this feature to gain better knowledge of the remote host.</description>
<fname>smb_enum_services.nasl</fname>
<iavt>0001-T-0751</iavt>
<plugin_modification_date>2020/09/22</plugin_modification_date>
